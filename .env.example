# Posting through our own drivers (accounts, OAuth, publish queue, reading comments and numbers back). Off: the team posts by hand.
FEATURE_PUBLISHING=false
# Claude called from the server (the Plan, Draft, Shorten and Change buttons; needs ANTHROPIC_API_KEY). Off: Claude works through the MCP connector.
FEATURE_CLAUDE_API=false

APP_NAME="Social Ops"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=socialops
DB_USERNAME=socialops
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Staff alerts also go to a Slack channel when this incoming webhook URL is set (Slack app > Incoming Webhooks)
SLACK_WEBHOOK_URL=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Client media: S3-compatible bucket in an EU region (GDPR). Set FILESYSTEM_DISK=s3 in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Claude API for trend research, planning and captions (the only paid third party besides hosting).
ANTHROPIC_API_KEY=
ANTHROPIC_PRICE_INPUT=
ANTHROPIC_PRICE_OUTPUT=
ANTHROPIC_MODEL=claude-opus-5-5

# Our own platform apps. Redirect URIs to register: ${APP_URL}/oauth/meta/callback, /oauth/tiktok/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_AUDITED=false
GOOGLE_SERVICE_ACCOUNT_JSON=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
DROPBOX_APP_KEY=
FFMPEG_PATH=ffmpeg

VITE_APP_NAME="${APP_NAME}"
